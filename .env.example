# Hodoku 本番環境変数のサンプル。これを .env にコピーして値を埋める。
# .env は .gitignore 済み。秘密情報はコミットしないこと。

# --- 公開URL（Origin検証・メールリンクに使用）。本番は https:// 必須 ---
BASE_URL=https://example.com

# --- セッション署名用。32文字以上。生成例: openssl rand -base64 48 ---
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- PostgreSQL（docker-compose の db サービス用） ---
POSTGRES_USER=hodoku
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=hodoku
# 外部DBを使う場合は docker-compose の app.environment の DATABASE_URL を直接指定する

# --- リバースプロキシ配下なら true（X-Forwarded-* を信頼） ---
TRUST_PROXY=true
# app をホストのどのアドレスにbindするか（前段プロキシのみなら 127.0.0.1）
APP_BIND=127.0.0.1

# --- メール送信（SMTP）。本番は必須 ---
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
# true=465のTLS直結 / false=587のSTARTTLS
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=Hodoku <no-reply@example.com>

# --- 決済（審査通過・実装接続までは disabled のまま） ---
PAYMENT_PROVIDER=disabled

# --- 出金（本人確認・税対応が整うまで false のまま） ---
PAYOUTS_ENABLED=false

# --- 業務パラメータ（必要に応じて） ---
PLATFORM_FEE_PERCENT=10
MIN_PAYOUT_YEN=1000
REFUND_WINDOW_HOURS=72
